/* ============================================================
   NTC DIGITAL PLATFORM
   FILE: frontend/src/index.css
   PURPOSE: Global styling + Portal Selection + Auth + Dashboard
   ============================================================ */

/* ============================================================
   GOOGLE FONT
   ============================================================ */

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap");


/* ============================================================
   GLOBAL RESET
   ============================================================ */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
  padding: 0;
}

html {
  font-family: "Inter", "Segoe UI", Arial, Helvetica, sans-serif;
}

body {
  font-family: "Inter", "Segoe UI", Arial, Helvetica, sans-serif;

  color: #172033;

  background: #eef4ff;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

button,
input,
textarea,
select {
  font-family: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}


/* ============================================================
   PORTAL PAGE
   ============================================================ */

.portal-page {
  position: relative;

  min-height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  padding: 45px 20px;

  overflow: hidden;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.35) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.35) 1px,
      transparent 1px
    ),
    radial-gradient(
      circle at 15% 15%,
      rgba(99, 102, 241, 0.20),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 18%,
      rgba(168, 85, 247, 0.18),
      transparent 30%
    ),
    radial-gradient(
      circle at 20% 85%,
      rgba(14, 165, 233, 0.16),
      transparent 32%
    ),
    radial-gradient(
      circle at 85% 85%,
      rgba(20, 184, 166, 0.18),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #f7f9ff 0%,
      #edf3ff 45%,
      #eefcfb 100%
    );

  background-size:
    45px 45px,
    45px 45px,
    auto,
    auto,
    auto,
    auto,
    auto;
}


/* ============================================================
   BACKGROUND DECORATION
   ============================================================ */

.portal-page::before {
  content: "";

  position: absolute;

  width: 520px;
  height: 520px;

  top: -260px;
  right: -170px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(99, 102, 241, 0.20),
      rgba(99, 102, 241, 0.04) 55%,
      transparent 72%
    );

  filter: blur(10px);

  pointer-events: none;
}

.portal-page::after {
  content: "";

  position: absolute;

  width: 480px;
  height: 480px;

  bottom: -270px;
  left: -170px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(20, 184, 166, 0.18),
      rgba(14, 165, 233, 0.06) 55%,
      transparent 72%
    );

  filter: blur(12px);

  pointer-events: none;
}


/* ============================================================
   PORTAL CONTAINER
   ============================================================ */

.portal-container {
  position: relative;
  z-index: 2;

  width: 100%;
  max-width: 620px;
}


/* ============================================================
   PORTAL HEADER
   ============================================================ */

.portal-header {
  display: flex;
  align-items: center;

  gap: 14px;

  margin-bottom: 25px;
}

.portal-logo {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 13px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 17px;
  font-weight: 800;

  letter-spacing: -0.4px;

  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.25);
}

.portal-header h1 {
  margin: 0;

  font-size: 22px;
  line-height: 1.15;

  font-weight: 700;

  color: #111827;

  letter-spacing: -0.4px;
}

.portal-header p {
  margin: 4px 0 0;

  font-size: 11px;
  line-height: 1.3;

  font-weight: 400;

  color: #64748b;
}


/* ============================================================
   WELCOME
   ============================================================ */

.portal-welcome {
  margin-bottom: 18px;
}

.portal-label {
  display: block;

  margin-bottom: 5px;

  font-size: 10px;
  line-height: 1;

  font-weight: 600;

  letter-spacing: 0.7px;

  color: #334155;
}

.portal-welcome h2 {
  margin: 0 0 5px;

  font-size: 25px;
  line-height: 1.15;

  font-weight: 700;

  color: #111827;

  letter-spacing: -0.5px;
}

.portal-welcome p {
  margin: 0;

  font-size: 12px;
  line-height: 1.4;

  font-weight: 400;

  color: #64748b;
}


/* ============================================================
   PORTAL LIST
   ============================================================ */

.portal-list {
  display: flex;

  flex-direction: column;

  gap: 11px;
}


/* ============================================================
   PORTAL CARD
   ============================================================ */

.portal-card {
  position: relative;

  width: 100%;
  min-height: 82px;

  display: flex;
  align-items: center;

  padding: 13px 17px;

  border: none;
  border-radius: 14px;

  color: #ffffff;

  text-align: left;

  cursor: pointer;

  overflow: hidden;

  font-family: "Inter", "Segoe UI", Arial, sans-serif;

  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.10);

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    filter 0.22s ease;
}


/* Decorative circle */

.portal-card::after {
  content: "";

  position: absolute;

  width: 125px;
  height: 125px;

  right: -45px;
  top: -45px;

  border-radius: 50%;

  background: rgba(255, 255, 255, 0.10);

  transition:
    transform 0.3s ease,
    background 0.3s ease;
}


/* Hover */

.portal-card:hover {
  transform: translateY(-3px) scale(1.01);

  box-shadow:
    0 14px 28px rgba(15, 23, 42, 0.16);

  filter: brightness(1.04);
}

.portal-card:hover::after {
  transform: scale(1.35);

  background: rgba(255, 255, 255, 0.14);
}


/* Active */

.portal-card:active {
  transform: scale(0.985);
}


/* Keyboard */

.portal-card:focus-visible {
  outline: 3px solid rgba(37, 99, 235, 0.35);
  outline-offset: 3px;
}


/* ============================================================
   PORTAL COLORS
   ============================================================ */

.portal-card.student {
  background:
    linear-gradient(
      135deg,
      #4f46e5,
      #4338ca
    );
}

.portal-card.admin {
  background:
    linear-gradient(
      135deg,
      #e11d48,
      #be123c
    );
}

.portal-card.teacher {
  background:
    linear-gradient(
      135deg,
      #0f9f8f,
      #0f766e
    );
}

.portal-card.ntc {
  background:
    linear-gradient(
      135deg,
      #d97706,
      #b45309
    );
}

.portal-card.results {
  background:
    linear-gradient(
      135deg,
      #7c3aed,
      #6d28d9
    );
}


/* ============================================================
   PORTAL ICON
   ============================================================ */

.portal-icon {
  position: relative;
  z-index: 2;

  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 11px;

  background: rgba(255, 255, 255, 0.94);

  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.45),
    0 4px 10px rgba(15, 23, 42, 0.08);

  font-size: 25px;

  line-height: 1;
}


/* ============================================================
   PORTAL CONTENT
   ============================================================ */

.portal-content {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  flex: 1;

  min-width: 0;

  margin-left: 14px;

  gap: 4px;
}

.portal-content h2 {
  margin: 0;

  font-size: 14px;
  line-height: 1.2;

  font-weight: 700;

  color: #ffffff;

  letter-spacing: -0.1px;
}

.portal-content p {
  margin: 0;

  font-size: 10px;
  line-height: 1.3;

  font-weight: 400;

  color: rgba(255, 255, 255, 0.92);
}


/* ============================================================
   PORTAL ARROW
   ============================================================ */

.portal-arrow {
  position: relative;
  z-index: 2;

  margin-left: 10px;

  font-size: 24px;
  line-height: 1;

  font-weight: 300;

  color: rgba(255, 255, 255, 0.90);

  transition:
    transform 0.2s ease;
}

.portal-card:hover .portal-arrow {
  transform: translateX(4px);
}


/* ============================================================
   PORTAL MESSAGE
   ============================================================ */

.portal-message {
  margin-top: 15px;

  padding: 11px 13px;

  border-radius: 8px;

  background: #fff1f2;

  border: 1px solid #fecdd3;

  color: #be123c;

  font-size: 11px;
}


/* ============================================================
   PORTAL FOOTER
   ============================================================ */

.portal-footer {
  margin-top: 18px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 5px;

  text-align: center;

  font-size: 10px;

  line-height: 1.3;

  color: #64748b;
}

.footer-title {
  font-weight: 600;
  color: #334155;
}

.footer-subtitle {
  font-weight: 400;
  color: #64748b;
}


/* ============================================================
   AUTH PAGE
   ============================================================ */

.auth-page {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.30) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.30) 1px,
      transparent 1px
    ),
    radial-gradient(
      circle at 20% 20%,
      rgba(99, 102, 241, 0.18),
      transparent 32%
    ),
    radial-gradient(
      circle at 80% 80%,
      rgba(20, 184, 166, 0.14),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #f7f9ff,
      #edf4ff,
      #f0fdfa
    );

  background-size:
    45px 45px,
    45px 45px,
    auto,
    auto,
    auto;
}


/* ============================================================
   AUTH CARD
   ============================================================ */

.auth-card {
  width: 100%;
  max-width: 380px;

  padding: 28px;

  background: rgba(255, 255, 255, 0.97);

  border: 1px solid rgba(255, 255, 255, 0.85);

  border-radius: 16px;

  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.12);

  backdrop-filter: blur(12px);
}


/* ============================================================
   BRAND
   ============================================================ */

.brand {
  display: flex;
  align-items: center;

  gap: 10px;
}

.brand-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 9px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-weight: 800;
  font-size: 19px;

  line-height: 1;

  box-shadow:
    0 6px 14px rgba(37, 99, 235, 0.22);
}

.brand h1 {
  margin: 0;

  font-size: 16px;
  line-height: 1.2;

  font-weight: 700;

  color: #172033;
}

.brand span {
  display: block;

  margin-top: 3px;

  font-size: 10px;
  line-height: 1.2;

  font-weight: 400;

  color: #64748b;
}


/* ============================================================
   AUTH HEADING
   ============================================================ */

.auth-heading {
  margin: 24px 0 18px;
}

.auth-heading h2 {
  margin: 0 0 7px;

  font-size: 23px;
  line-height: 1.2;

  font-weight: 700;

  color: #172033;

  letter-spacing: -0.4px;
}

.auth-heading p {
  margin: 0;

  color: #64748b;

  font-size: 12px;
  line-height: 1.4;

  font-weight: 400;
}


/* ============================================================
   FORM
   ============================================================ */

.field {
  margin-bottom: 15px;
}

.field label {
  display: block;

  margin-bottom: 6px;

  font-size: 11px;
  line-height: 1.2;

  font-weight: 600;

  color: #334155;
}

.field input {
  width: 100%;

  padding: 11px 12px;

  border: 1px solid #cbd5e1;

  border-radius: 7px;

  outline: none;

  font-size: 12px;
  line-height: 1.3;

  font-weight: 400;

  background: #ffffff;

  color: #172033;

  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease;
}

.field input::placeholder {
  color: #94a3b8;
}

.field input:focus {
  border-color: #2563eb;

  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.10);
}


/* ============================================================
   PRIMARY BUTTON
   ============================================================ */

.primary-button {
  width: 100%;

  border: none;

  border-radius: 7px;

  padding: 11px;

  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color: #ffffff;

  font-size: 12px;
  line-height: 1.2;

  font-weight: 600;

  cursor: pointer;

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

.primary-button:hover {
  transform: translateY(-1px);

  box-shadow:
    0 6px 14px rgba(37, 99, 235, 0.22);
}

.primary-button:disabled {
  opacity: 0.65;

  cursor: not-allowed;

  transform: none;
}


/* ============================================================
   ALERTS
   ============================================================ */

.alert {
  padding: 10px 12px;

  border-radius: 7px;

  margin-bottom: 15px;

  font-size: 11px;
}

.alert.error {
  background: #fff1f2;

  border: 1px solid #fecdd3;

  color: #be123c;
}

.alert.success {
  background: #f0fdf4;

  border: 1px solid #bbf7d0;

  color: #15803d;
}


/* ============================================================
   AUTH SWITCH
   ============================================================ */

.auth-switch {
  margin-top: 18px;

  text-align: center;

  color: #64748b;

  font-size: 11px;
}

.auth-switch button {
  border: none;

  background: none;

  padding: 0;

  color: #2563eb;

  cursor: pointer;

  font-size: 11px;
  font-weight: 600;
}


/* ============================================================
   BACK TO PORTALS
   ============================================================ */

.back-button {
  margin-top: 12px;

  border: 1px solid #cbd5e1;

  background: #ffffff;

  color: #334155;

  border-radius: 6px;

  padding: 7px 11px;

  font-size: 10px;

  font-weight: 500;

  cursor: pointer;
}

.back-button:hover {
  background: #f8fafc;

  border-color: #94a3b8;
}


/* ============================================================
   DASHBOARD
   ============================================================ */

.dashboard {
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(99, 102, 241, 0.12),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #f7f9ff,
      #eef4ff
    );
}


/* ============================================================
   TOP BAR
   ============================================================ */

.topbar {
  height: 64px;

  background: rgba(255, 255, 255, 0.94);

  border-bottom: 1px solid #e2e8f0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 48px;

  backdrop-filter: blur(10px);
}

.profile {
  display: flex;
  align-items: center;

  gap: 15px;
}

.profile-info {
  display: flex;
  flex-direction: column;

  text-align: right;
}

.profile-info strong {
  font-size: 12px;

  font-weight: 600;
}

.profile-info span {
  margin-top: 2px;

  font-size: 9px;

  color: #64748b;
}

.logout-button {
  background: #ffffff;

  border: 1px solid #cbd5e1;

  border-radius: 6px;

  padding: 7px 12px;

  cursor: pointer;

  font-size: 10px;

  transition:
    background 0.15s ease,
    border-color 0.15s ease;
}

.logout-button:hover {
  background: #f8fafc;

  border-color: #94a3b8;
}


/* ============================================================
   DASHBOARD CONTENT
   ============================================================ */

.dashboard-content {
  max-width: 1100px;

  margin: 0 auto;

  padding: 35px 24px;
}

.welcome {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  margin-bottom: 24px;
}

.eyebrow {
  margin: 0 0 8px;

  color: #2563eb;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 1.2px;
}

.welcome h2 {
  margin: 0 0 7px;

  font-size: 25px;

  font-weight: 700;
}

.welcome p {
  margin: 0;

  color: #64748b;

  font-size: 12px;
}


/* ============================================================
   TASK PANEL
   ============================================================ */

.task-panel {
  background: rgba(255, 255, 255, 0.96);

  border: 1px solid #e2e8f0;

  border-radius: 13px;

  padding: 20px;

  box-shadow:
    0 8px 25px rgba(15, 23, 42, 0.05);
}

.panel-header h3 {
  margin: 0 0 5px;

  font-size: 16px;

  font-weight: 700;
}

.panel-header p {
  margin: 0 0 16px;

  color: #64748b;

  font-size: 10px;
}


/* ============================================================
   TASK FORM
   ============================================================ */

.task-form {
  display: flex;

  gap: 8px;

  margin-bottom: 18px;
}

.task-form input {
  flex: 1;

  padding: 10px;

  border: 1px solid #cbd5e1;

  border-radius: 7px;

  outline: none;
}

.task-form input:focus {
  border-color: #2563eb;
}

.task-form button {
  border: none;

  padding: 0 16px;

  border-radius: 7px;

  background: #2563eb;

  color: #ffffff;

  cursor: pointer;
}


/* ============================================================
   STATS
   ============================================================ */

.dashboard-stats {
  display: flex;

  gap: 10px;

  margin-bottom: 18px;
}

.stats-card {
  min-width: 100px;

  padding: 13px;

  background: #ffffff;

  border: 1px solid #e2e8f0;

  border-radius: 10px;
}

.stats-card span {
  display: block;

  color: #64748b;

  font-size: 9px;

  margin-bottom: 5px;
}

.stats-card strong {
  color: #2563eb;

  font-size: 20px;
}


/* ============================================================
   EMPTY STATE
   ============================================================ */

.empty-state {
  border: 1px dashed #cbd5e1;

  border-radius: 10px;

  min-height: 180px;

  display: flex;
  align-items: center;
  justify-content: center;

  flex-direction: column;

  text-align: center;

  background: #fbfdff;
}

.empty-icon {
  width: 35px;
  height: 35px;

  border-radius: 50%;

  background: #eff6ff;

  color: #2563eb;

  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state h3 {
  margin: 10px 0 5px;

  font-size: 13px;
}

.empty-state p {
  margin: 0;

  color: #94a3b8;

  font-size: 10px;
}


/* ============================================================
   TASK LIST
   ============================================================ */

.task-list {
  list-style: none;

  padding: 0;

  margin: 0;
}

.task-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 12px;

  margin-bottom: 8px;

  border: 1px solid #e2e8f0;

  border-radius: 8px;

  background: #f8fafc;
}

.task-list li.done span {
  text-decoration: line-through;

  color: #94a3b8;
}

.task-actions {
  display: flex;

  gap: 6px;
}

.task-actions button {
  border: 1px solid #cbd5e1;

  background: #ffffff;

  border-radius: 5px;

  padding: 6px 9px;

  font-size: 10px;

  cursor: pointer;
}


/* ============================================================
   LOADING
   ============================================================ */

.loading {
  padding: 40px;

  text-align: center;

  color: #64748b;

  font-size: 12px;
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 650px) {

  .portal-page {
    align-items: flex-start;

    padding: 30px 14px 35px;
  }

  .portal-container {
    max-width: 100%;
  }

  .portal-header {
    margin-bottom: 22px;
  }

  .portal-logo {
    width: 44px;
    height: 44px;
  }

  .portal-header h1 {
    font-size: 19px;
  }

  .portal-welcome h2 {
    font-size: 22px;
  }

  .portal-card {
    min-height: 74px;

    padding: 11px 13px;
  }

  .portal-icon {
    width: 44px;
    height: 44px;

    font-size: 22px;
  }

  .portal-content {
    margin-left: 11px;
  }

  .portal-content h2 {
    font-size: 13px;
  }

  .portal-content p {
    font-size: 9px;
  }

  .portal-arrow {
    font-size: 22px;
  }

  .topbar {
    padding: 0 18px;
  }

  .dashboard-content {
    padding: 25px 15px;
  }

  .welcome {
    gap: 15px;
  }

  .welcome .stats-card {
    display: none;
  }

  .task-form {
    flex-direction: column;
  }

  .task-form button {
    min-height: 40px;
  }

  .task-list li {
    align-items: flex-start;

    flex-direction: column;
  }

  .task-actions {
    width: 100%;
  }

  .task-actions button {
    flex: 1;
  }

  .portal-footer {
    flex-direction: column;

    gap: 2px;

    margin-top: 16px;

    font-size: 9px;
  }
}


/* ============================================================
   VERY SMALL MOBILE
   ============================================================ */

@media (max-width: 400px) {

  .portal-page {
    padding-left: 10px;
    padding-right: 10px;
  }

  .portal-card {
    min-height: 70px;
  }

  .portal-icon {
    width: 40px;
    height: 40px;

    font-size: 20px;
  }

  .portal-content h2 {
    font-size: 12px;
  }

  .portal-content p {
    font-size: 8px;
  }

  .portal-header h1 {
    font-size: 18px;
  }

  .portal-welcome h2 {
    font-size: 21px;
  }
}